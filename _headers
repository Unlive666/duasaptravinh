/*
  X-Frame-Options: DENY
  X-XSS-Protection: 1; mode=block
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://img.vietqr.io https://duasaptravinh.vercel.app; media-src 'self' https://duasaptravinh.vercel.app; connect-src 'self' https://dua-sap-chatbot.onrender.com https://api.telegram.org; frame-ancestors 'none'; base-uri 'self'; form-action 'self';

/images/*
  Cache-Control: public, max-age=31536000, immutable
